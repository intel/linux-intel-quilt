From 2edab7180f12dc91dec0eade1029c6a85666bb9e Mon Sep 17 00:00:00 2001
From: "Dutta, Ranjan" <ranjan.dutta@intel.com>
Date: Mon, 12 Oct 2026 10:41:04 +0800
Subject: [PATCH 2/3] media: i2c: d4xx: remove always-true check in
 ds5_parse_cam()

depth_b and rgb_b are structures embedded in struct ds5, so their
addresses can never be NULL and the check always evaluates to true.
GCC 13 flags this, which breaks the build with CONFIG_WERROR:

  drivers/media/i2c/d4xx.c:4397:32: error: the comparison will always
  evaluate as 'true' for the address of 'depth_b' will never be NULL
  [-Werror=address]

Remove the check and initialize both sensor formats unconditionally.
No functional change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/i2c/d4xx.c | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/drivers/media/i2c/d4xx.c b/drivers/media/i2c/d4xx.c
index 2be531a013e09..996f7429405b7 100644
--- a/drivers/media/i2c/d4xx.c
+++ b/drivers/media/i2c/d4xx.c
@@ -4394,10 +4394,8 @@ static int ds5_parse_cam(struct i2c_client *client, struct ds5 *state)
 	ds5_sensor_format_init(&state->motion_t.sensor);
 	ds5_sensor_format_init(&state->rgb.sensor);
 	ds5_sensor_format_init(&state->imu.sensor);
-	if ((&(state->depth_b) != NULL) && (&(state->rgb_b) != NULL)) {
-		ds5_sensor_format_init(&state->depth_b.sensor);
-		ds5_sensor_format_init(&state->rgb_b.sensor);
-	}
+	ds5_sensor_format_init(&state->depth_b.sensor);
+	ds5_sensor_format_init(&state->rgb_b.sensor);
 
 	return 0;
 }
-- 
2.43.0


From 31d41112c11da3ad3339114901b68987c5938dfb Mon Sep 17 00:00:00 2001
From: Rajvi Jingar <rajvi.jingar@intel.com>
Date: Fri, 10 Jan 2020 15:49:42 -0800
Subject: [PATCH] Added TGPIO pin check before input event read

This patch adds check for PTP_PINDESC_INPUTDISABLE flag before
performing read to input event.

Signed-off-by: Rajvi Jingar <rajvi.jingar@intel.com>
---
 tools/testing/selftests/ptp/testptp.c | 33 +++++++++++++++------------
 1 file changed, 19 insertions(+), 14 deletions(-)

diff --git a/tools/testing/selftests/ptp/testptp.c b/tools/testing/selftests/ptp/testptp.c
index 8f05212f82329..3763c5ba1258d 100644
--- a/tools/testing/selftests/ptp/testptp.c
+++ b/tools/testing/selftests/ptp/testptp.c
@@ -430,21 +430,26 @@ int main(int argc, char *argv[])
 				puts("external time stamp request okay");
 			}
 		}
-		for (; extts; extts--) {
-			cnt = read(fd, &event, sizeof(event));
-			if (cnt != sizeof(event)) {
-				perror("read");
-				break;
+		memset(&desc, 0, sizeof(desc));
+		desc.index = index;
+		if (ioctl(fd, PTP_PIN_GETFUNC2, &desc))
+			perror("PTP_PIN_GETFUNC2");
+		if (!(desc.flags & PTP_PINDESC_INPUTDISABLE)) {
+			for (; extts; extts--) {
+				cnt = read(fd, &event, sizeof(event));
+				if (cnt != sizeof(event)) {
+					perror("read");
+					break;
+				}
+				printf("event index %u at %lld.%09u\n", event.index,
+				       event.t.sec, event.t.nsec);
+				fflush(stdout);
 			}
-			printf("event index %u at %lld.%09u\n", event.index,
-			       event.t.sec, event.t.nsec);
-			fflush(stdout);
-		}
-		if (!readonly) {
-			/* Disable the feature again. */
-			extts_request.flags = 0;
-			if (ioctl(fd, PTP_EXTTS_REQUEST, &extts_request)) {
-				perror("PTP_EXTTS_REQUEST");
+			if (!readonly) {
+				/* Disable the feature again. */
+				extts_request.flags = 0;
+				if (ioctl(fd, PTP_EXTTS_REQUEST, &extts_request))
+					perror("PTP_EXTTS_REQUEST");
 			}
 		}
 	}
-- 
2.43.0


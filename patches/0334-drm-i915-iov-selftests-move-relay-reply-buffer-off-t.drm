From 9d7c389b9293dd6f30dd176b59c553a48e19c838 Mon Sep 17 00:00:00 2001
From: "Dutta, Ranjan" <ranjan.dutta@intel.com>
Date: Mon, 12 Oct 2026 10:41:04 +0800
Subject: [PATCH 3/3] drm/i915/iov: selftests: move relay reply buffer off the
 stack

pf_full_loopback_to_vf() and relay_request_to_pf() keep both the
request and the reply buffer on the stack. Each buffer is
VF2PF_MSG_MAX_LEN (252) dwords, so together they take 2016 bytes.
With KASAN_STACK redzones that exceeds CONFIG_FRAME_WARN=2048 and
breaks allmodconfig/allyesconfig builds with CONFIG_WERROR:

  selftest_live_iov_relay.c:387:1: error: the frame size of 2360 bytes
  is larger than 2048 bytes [-Werror=frame-larger-than=]
  selftest_live_iov_relay.c:472:1: error: the frame size of 2352 bytes
  is larger than 2048 bytes [-Werror=frame-larger-than=]

Allocate the reply buffer with kmalloc_array() instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../iov/selftests/selftest_live_iov_relay.c   | 23 +++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/i915/gt/iov/selftests/selftest_live_iov_relay.c b/drivers/gpu/drm/i915/gt/iov/selftests/selftest_live_iov_relay.c
index b3ef7dcedf534..f95b63eda43c3 100644
--- a/drivers/gpu/drm/i915/gt/iov/selftests/selftest_live_iov_relay.c
+++ b/drivers/gpu/drm/i915/gt/iov/selftests/selftest_live_iov_relay.c
@@ -356,16 +356,22 @@ static int pf_full_loopback_to_vf(void *arg)
 		FIELD_PREP(GUC_HXG_REQUEST_MSG_n_DATAn, SELFTEST_RELAY_DATA),
 		/* ... */
 	};
-	u32 buf[PF2GUC_RELAY_TO_VF_REQUEST_MSG_NUM_RELAY_DATA];
+	const u32 buf_size = PF2GUC_RELAY_TO_VF_REQUEST_MSG_NUM_RELAY_DATA;
+	u32 *buf;
 	unsigned int n;
 	int ret = 0;
 
+	/* too big for the stack together with msg */
+	buf = kmalloc_array(buf_size, sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
 	iov->relay.selftest.enable_loopback = 1;
 
 	for (n = GUC_HXG_MSG_MIN_LEN; n <= ARRAY_SIZE(msg); n++) {
 
 		ret = intel_iov_relay_send_to_vf(&iov->relay, PFID, msg, n,
-						 buf, ARRAY_SIZE(buf));
+						 buf, buf_size);
 
 		if (ret < 0) {
 			IOV_SELFTEST_ERROR(iov, "failed to send msg len=%u, %d\n", n, ret);
@@ -382,6 +388,7 @@ static int pf_full_loopback_to_vf(void *arg)
 	}
 
 	iov->relay.selftest.enable_loopback = 0;
+	kfree(buf);
 
 	return ret;
 }
@@ -445,14 +452,20 @@ static int relay_request_to_pf(struct intel_iov *iov)
 		FIELD_PREP(GUC_HXG_REQUEST_MSG_n_DATAn, SELFTEST_RELAY_DATA),
 		/* ... */
 	};
-	u32 buf[PF2GUC_RELAY_TO_VF_REQUEST_MSG_NUM_RELAY_DATA];
+	const u32 buf_size = PF2GUC_RELAY_TO_VF_REQUEST_MSG_NUM_RELAY_DATA;
+	u32 *buf;
 	unsigned int n;
 	int ret = 0;
 
+	/* too big for the stack together with msg */
+	buf = kmalloc_array(buf_size, sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
 	for (n = GUC_HXG_MSG_MIN_LEN; n <= ARRAY_SIZE(msg); n++) {
 
 		ret = intel_iov_relay_send_to_pf(&iov->relay, msg, n,
-						 buf, ARRAY_SIZE(buf));
+						 buf, buf_size);
 
 		if (ret < 0) {
 			IOV_SELFTEST_ERROR(iov, "failed to send len=%u, %d\n", n, ret);
@@ -468,6 +481,8 @@ static int relay_request_to_pf(struct intel_iov *iov)
 		ret = 0;
 	}
 
+	kfree(buf);
+
 	return ret;
 }
 
-- 
2.43.0

